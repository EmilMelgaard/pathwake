<?xml version="1.0" encoding="utf-8"?>
<!-- Themed icon: the launcher icon's foreground in one color; the line is the strongest. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Moved up so the puzzle grid is centered, and scaled to keep the bells in the safe zone. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.94"
        android:scaleY="0.94"
        android:translateY="-3.76">
        <!-- Bells and feet, cut off at the rim: overlapping see-through shapes would show up lighter there -->
        <group>
            <!-- Everything except the face (a counterclockwise circle cuts a hole in the clockwise square) -->
            <clip-path android:pathData="M0,0H108V108H0ZM28.25,58a25.75,25.75 0,1 0,51.5 0a25.75,25.75 0,1 0,-51.5 0Z" />
            <path
                android:fillColor="#B3000000"
                android:pathData="M29.94,46.66A9,9 0,0 1,42.66 33.94ZM65.34,33.94A9,9 0,0 1,78.06 46.66Z" />
            <path
                android:pathData="M42.5,79L39.5,84M65.5,79L68.5,84"
                android:strokeWidth="4"
                android:strokeColor="#B3000000"
                android:strokeLineCap="round" />
        </group>
        <!-- Face -->
        <path
            android:pathData="M54,58m-24,0a24,24 0,1 0,48 0a24,24 0,1 0,-48 0"
            android:strokeWidth="3.5"
            android:strokeColor="#B3000000" />
        <!-- Puzzle grid (4x4 cells) with its exit at the top -->
        <path
            android:pathData="M41,45H67M41,51.5H67M41,58H67M41,64.5H67M41,71H67M41,45V71M47.5,45V71M54,39V71M60.5,45V71M67,45V71"
            android:strokeWidth="2.4"
            android:strokeColor="#59000000"
            android:strokeLineCap="round" />
        <!-- The line from the start circle to the exit, which also forms the clock's hands -->
        <path
            android:pathData="M41,58H54V39"
            android:strokeWidth="3.4"
            android:strokeColor="#FF000000"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:fillColor="#FF000000"
            android:pathData="M41,58m-4.5,0a4.5,4.5 0,1 0,9 0a4.5,4.5 0,1 0,-9 0" />
    </group>
</vector>
